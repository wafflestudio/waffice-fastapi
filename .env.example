# Environment
ENV=local

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waffice

# JWT
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# OCI Object Storage
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=ap-chuncheon-1
# Use instance_principal in OKE. Use config_file for local development.
OCI_OBJECT_STORAGE_AUTH=config_file
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_PUBLIC_BASE_URL=

# AWS Secrets Manager (for dev/prod environments)
# AWS_SECRET_NAME=waffice-db-credentials
# AWS_REGION=ap-northeast-2
